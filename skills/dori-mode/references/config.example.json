{
  "stateDir": "~/.dori/state",
  "terminal": "hc",
  "laneWorkspace": "lanes",
  "workspaces": [
    "lanes"
  ],
  "ignorePanes": [],
  "leadPane": "<your own hc terminal: its name, e.g. dori-lead, or $HC_TERMINAL_ID>",
  "defaultCwd": "~/code/my-project",
  "agentCommand": [
    "omp",
    "--model",
    "{model}",
    "--goal",
    "{prompt}"
  ],
  "defaultModel": "anthropic/claude-opus-5-5",
  "launchKeywords": "",
  "goalMarker": "🎯 Goal",
  "sessionsDir": "~/.omp/agent/sessions",
  "nudgeAfterMin": 15,
  "postAfterMin": 20,
  "closeAfterMin": 5,
  "repoIdentities": {
    "my-org/my-project": {
      "name": "Your Name",
      "email": "12345+you@users.noreply.github.com"
    }
  },
  "supervision": {
    "hungAfterMinutes": 20,
    "staleAfterMinutes": 20,
    "defaults": { "wallMinutes": null, "tokens": null, "costUsd": null },
    "lanes": {},
    "activityPaths": [],
    "gitActivity": true
  },
  "heavySlots": 1,
  "heavyMaxLoad": 80,
  "deadPanePatterns": [
    "has stopped",
    "closing session",
    "no suitable jobs"
  ],
  "guard": {
    "loadAlert": 150,
    "loadOk": 80,
    "memFreeMinPct": 20,
    "diskFreeMinGb": 50,
    "panesMax": 20
  },
  "hooks": {
    "threadReply": [
      "my-messenger",
      "reply",
      "--thread",
      "{thread}",
      "--text",
      "{text}"
    ],
    "threadDone": [
      "my-messenger",
      "set-status",
      "--thread",
      "{thread}",
      "--status",
      "done",
      "--note",
      "{text}"
    ],
    "transcribe": [
      "my-stt",
      "--file",
      "{file}"
    ]
  }
}
